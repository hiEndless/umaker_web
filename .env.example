# 复制为 .env 后填写。不要提交真实值。
# Wrangler / CI 读取 CLOUDFLARE_API_TOKEN 与 CLOUDFLARE_ACCOUNT_ID。
# Workers 运行时密钥用 apps/api/.dev.vars（见同目录 .dev.vars.example）。

# ── 账号与 CLI（Workers / Pages / D1 / KV / Queue / Vectorize / Workers AI）──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 仅在必须调用某 Zone API 时填写
CLOUDFLARE_ZONE_ID=

# 不推荐：Global API Key（优先用 API Token）
# CLOUDFLARE_EMAIL=
# CLOUDFLARE_API_KEY=

# ── Pages ──
CLOUDFLARE_PAGES_PROJECT_NAME=umaker-web

# ── D1 ──
CLOUDFLARE_D1_DATABASE_NAME=umaker-web-api-db
CLOUDFLARE_D1_DATABASE_ID=

# ── KV ──
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_PREVIEW_NAMESPACE_ID=

# ── R2（S3 兼容凭证，控制台 R2 > Manage R2 API Tokens）──
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=umaker-web-api-bucket
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_JURISDICTION=

# ── Queue ──
CLOUDFLARE_QUEUE_NAME=umaker-web-api-queue

# ── Hyperdrive（连接串走密钥，不要写入 wrangler.toml）──
CLOUDFLARE_HYPERDRIVE_ID=
CLOUDFLARE_HYPERDRIVE_CONNECTION_STRING=

# ── Workers AI / AI Gateway ──
# REST 调用复用 CLOUDFLARE_API_TOKEN（需 Workers AI 权限）
CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=

# ── Vectorize ──
CLOUDFLARE_VECTORIZE_INDEX_NAME=

# ── Browser Rendering ──
# 复用 CLOUDFLARE_API_TOKEN（需 Browser Rendering 权限）

# ── Images ──
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_SIGNING_KEY=

# ── Stream ──
CLOUDFLARE_STREAM_SUBDOMAIN=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY=

# ── Turnstile ──
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Zero Trust / Access ──
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# ── Tunnel（cloudflared）──
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# ── DNS / 证书（API Token 需 Zone.DNS）──
CLOUDFLARE_DNS_API_TOKEN=

# ── Analytics / Logpush（独立 Token 建议最小权限）──
CLOUDFLARE_ANALYTICS_API_TOKEN=

# ── Node / Docker ──
PORT=3000
